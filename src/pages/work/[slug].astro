---
import JsonLd from '../../components/JsonLd.astro';
import { AUTHOR } from '../../lib/site';
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectHeader from '../../components/ProjectHeader.astro';
import { getWorks, getNeighbors, descriptorOf } from '../../lib/works';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({
    params: { slug: work.id },
    props: { work },
  }));
}

const { work } = Astro.props;
const { title, year, images } = work.data;
const ogImg = await getImage({ src: images[0].src, format: 'jpg', width: 1200, height: 630, fit: 'cover' });

const descriptor = descriptorOf(work);
const pageTitle = `${title} — ${descriptor}, ${year} · Ryodgie Barnatia`;
const description = images[0].alt || `${title}, ${descriptor} by Ryodgie Barnatia.`;
const { prev, next } = await getNeighbors(work.id);

const workSchema = {
  '@context': 'https://schema.org',
  '@type': 'VisualArtwork',
  name: title,
  creator: AUTHOR,
  url: new URL(Astro.url.pathname, Astro.site).href,
  image: ogImg.src,
  dateCreated: work.data.createdAt,
  ...(work.data.liveUrl && { sameAs: work.data.liveUrl }),
};
---

<BaseLayout title={pageTitle} description={description} ogType="article" ogImage={ogImg.src}>
  <JsonLd schema={workSchema} />
  <main class="project">
    <a class="back" href="/" id="back-link">← back to the wall</a>

    <ProjectHeader work={work} />

    <div class="project-frames">
      {images.map((img, i) => (
        <figure style={`aspect-ratio: ${img.src.width}/${img.src.height};`}>
          <Picture
            src={img.src}
            alt={img.alt}
            formats={['avif', 'webp']}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 639px) 100vw, (max-width: 1024px) 90vw, 1000px"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </figure>
      ))}
    </div>
    <nav class="project-nav">
      {prev ? (
        <a class="pn-link" href={`/work/${prev.id}`}>
          <span class="pn-label">Previous</span>
          <span class="pn-title">{prev.data.title}</span>
        </a>
      ) : <span />}

      {next ? (
        <a class="pn-link pn-next" href={`/work/${next.id}`}>
          <span class="pn-label">Next</span>
          <span class="pn-title">{next.data.title}</span>
        </a>
      ) : <span />}
    </nav>
  </main>
  

 <script>
    document.getElementById('back-link')?.addEventListener('click', (e) => {
      if (document.referrer && new URL(document.referrer).pathname === '/') {
        e.preventDefault();
        history.back();
      }
    });

    document.querySelectorAll<HTMLButtonElement>('.swatch').forEach((sw) => {
      sw.addEventListener('click', async () => {
        const hex = sw.dataset.hex;
        if (!hex) return;
        try {
          await navigator.clipboard.writeText(hex);
          sw.classList.add('copied');
          setTimeout(() => sw.classList.remove('copied'), 1000);
        } catch {}
      });
    });
  </script>
</BaseLayout>