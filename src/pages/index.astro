---
import JsonLd from '../components/JsonLd.astro';
import { EMAIL, SOCIALS, JOB_TITLE, AUTHOR } from '../lib/site';
import Header from '../components/Header.astro';
import FilterBar from '../components/FilterBar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkRow from '../components/WorkRow.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import { getWall } from '../lib/works';

const works = await getWall();

const filterData = works.map((w) => ({
  id: w.id,
  medium: w.data.medium,
  live: !!w.data.liveUrl,
  tags: w.data.tags,
}));

const personSchema = {
  '@context': 'https://schema.org',
  ...AUTHOR,
  email: `mailto:${EMAIL}`,
  jobTitle: JOB_TITLE,
  sameAs: [SOCIALS.linkedin, SOCIALS.dribbble, SOCIALS.github],
};
---
<BaseLayout
  title="Ryodgie Barnatia — Front-End Web Designer & Developer"
  description="Ryodgie Barnatia — front-end web designer and developer working in Astro, React, and Vue. A wall of live coded websites, editorial, type, and design experiments."
>
  <JsonLd schema={personSchema} />
  <main class="wall">
    <Header />
    <FilterBar />
    {works.map((work, i) => <WorkRow work={work} index={i} />)}
    <p class="wall-empty" hidden>Nothing here yet — check back as the wall grows.</p>
    <button class="btn-accent load-more" hidden>Load more</button>
    <About />
    <Footer />
  </main>

  <script is:inline define:vars={{ filterData }}>
    window.__FILTERS = filterData;
  </script>
  <script src="../scripts/wall.js"></script>
</BaseLayout>