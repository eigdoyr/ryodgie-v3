---
import type { Work } from '../lib/works';
import { descriptorOf } from '../lib/works';

interface Props { work: Work; badge?: string | null }
const { work, badge = null } = Astro.props;
const { title, series, year, fonts } = work.data;

const descriptor = descriptorOf(work);
const head = series ? `${title} // ${series}` : title;
---
<div class="caption">
  <div class="cap-line">
    <span class="cap-title">
      {head}
      {badge && <span class="badge">{badge}</span>}
    </span>
    <span class="cap-meta">{descriptor}, {year}</span>
  </div>
  <div>Fonts: {fonts.join(' & ')}</div>
</div>