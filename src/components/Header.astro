---
import { EMAIL } from '../lib/site';
---

<header class="site-header">
  <nav class="top">
    <h1 class="name"><a href="/">Ryodgie Barnatia</a></h1>
    <a href="#about">About</a>
  </nav>

<div class="intro">
    <div class="intro-left">
      <p class="tagline">
        Designer & Developer specializing in brand identity, custom websites, and e-commerce.
      </p>
      <p class="status">
        <a class="email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
    </div>

    <div class="intro-right">
      <p>
        For brands, studios, and people with an audience who want a website made to measure, not picked from a theme or a corporate template.
      </p>

      <p class="divider">( Selected and Unselected )</p>
      <p class="index-note">
        An open index of identities, editorials, and websites, added to as they’re made.
      </p>
    </div>
  </div>

</header>