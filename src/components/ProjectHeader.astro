---
import { descriptorOf, type Work } from '../lib/works';

interface Props { work: Work }
const { work } = Astro.props;
const { title, series, year, fonts, liveUrl, colors } = work.data;

const descriptor = descriptorOf(work);
---
<header class="project-header">
  <div class="ph-title">
    <span class="ph-name">{title}</span>
    {series && <span class="ph-series">{series}</span>}
  </div>

  <dl class="ph-meta">
    <div class="ph-row">
      <dt>Medium</dt>
      <dd>{descriptor}, {year}</dd>
    </div>

    {fonts.length > 0 && (
  <div class="ph-row">
    <dt>Fonts</dt>
    <dd>{fonts.join(' & ')}</dd>
  </div>
)}

    {colors.length > 0 && (
      <div class="ph-row">
        <dt>Colors</dt>
        <dd>
          <div class="swatches">
            {colors.map((c) => (
              <button class="swatch" style={`--c: ${c};`} data-hex={c} aria-label={`Copy ${c}`} title={c}></button>
            ))}
          </div>
        </dd>
      </div>
    )}

    {liveUrl && (
      <div class="ph-row">
        <dt>Live</dt>
        <dd><a class="live" href={liveUrl} rel="noopener" target="_blank">view live site →</a></dd>
      </div>
    )}
  </dl>
</header>