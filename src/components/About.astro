---
import { EMAIL } from '../lib/site';

const columns = [
  {
    label: 'Services',
    items: [
      'Web design & redesigns',
      'Brand & visual identity',
      'Design direction',
      'Launch & campaign pages',
      'Lookbooks & digital editorials',
      'Art direction',
      'Design & UX reviews',
      'Shopify & headless e-commerce',
    ],
  },
  {
    label: 'Interests',
    items: [
      'Editorial design',
      'Typography',
      'Grid systems',
      'Minimalism',
      'Brutalism',
      'Print and Digital magazines',
      'Photography',
    ],
  },
];

---

<section class="about" id="about">
  <div class="about-label">About</div>

  <div class="about-body">
    <p>
      Ryodgie Barnatia ( ree-yoh-jee ).
    </p>
    <p>
      I design identities, editorials, and the websites and stores that carry them, then build them myself, so nothing is lost between the two.
    </p>
    <p>
      Before design, a decade with the <span class="highlight">Los Angeles Times</span> and <span class="highlight">Tribune Publishing</span>, where I learned how a publication holds attention: hierarchy, pacing, restraint. Then front-end development at <span class="highlight">MC2</span>, and visual design for AI training at <span class="highlight">Wirestock</span>.
    </p>
    <div class="about-cols">
      {columns.map((column) => (
        <div class="about-col">
          <h2 class="about-col-label">{column.label}</h2>
          <ul>
            {column.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      ))}
    </div>

    <p class="about-cta">
      For new projects, or a second look at an existing one — <a class="email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </p>
  </div>
</section>